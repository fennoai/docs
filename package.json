{
  "name": "fenno-developer-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Fenno public developer docs site (docs.fenno.ai)",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "pnpm preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test:layout": "node --test scripts/docs-layout.test.mjs",
    "preview": "python3 -m http.server 4000 -d out",
    "assets": "node scripts/generate-assets.mjs",
    "test:seo": "node --test scripts/seo.test.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "next": "^16.0.7",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pagefind": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0"
}
